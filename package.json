  },
  "files": [
    "README.md",
    "bin/vecteur.js",
    "src/client.js",
    "src/contract.js",
    "src/credentials.js",
    "src/download.js",
    "src/errors.js",
    "src/format.js",
    "src/mcp.js",
    "src/projects.js",
    "src/store.js",
    "src/folders.js",
    "src/browser.js",
    "src/blocks.js",
    "src/session.js",
    "src/input.js",
    "src/commands.js",
    "src/terminal.js",
    "src/markdown.js",
    "src/tui/view.js",
    "src/diagnostics.js",
    "src/preferences.js",
    "src/update.js",
    "src/vendors.js"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "contract:check": "node scripts/gen-contract.mjs --check",
    "verify-package": "node scripts/verify-package.mjs",
    "prepublishOnly": "npm test && npm run contract:check && npm run verify-package"
